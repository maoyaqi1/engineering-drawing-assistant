.terms-shell {
  padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f7fb;
  min-height: 100vh;
}

.terms-update {
  display: block;
  color: #8290a3;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

.terms-section {
  margin-bottom: 34rpx;
}

.terms-h {
  display: block;
  color: #16223a;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.terms-p {
  display: block;
  color: #3b4a60;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.terms-foot {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 44rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #dfe5ee;
  color: #8a97a8;
  font-size: 23rpx;
}

/* ---- 宽屏适配（PAD / 折叠屏 / 横屏）：文字与控件保持与手机等大 ----
   rpx 会随窗口宽度放大，这里按 1rpx = 0.5px 换算成 px，使大屏上的字号、间距、按钮与手机一致。 */
@media (min-width: 500px) {
  .terms-shell { padding: 16px 20px calc(24px + env(safe-area-inset-bottom)); }
  .terms-update { font-size: 12px; margin-bottom: 15px; }
  .terms-section { margin-bottom: 17px; }
  .terms-h { font-size: 15px; margin-bottom: 7px; }
  .terms-p { font-size: 14px; }
  .terms-foot { gap: 4px; margin-top: 22px; padding-top: 14px; border-top: 0.5px solid #dfe5ee; font-size: 11.5px; }
}
