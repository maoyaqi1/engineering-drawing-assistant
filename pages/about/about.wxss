@import "../../styles/info-page.wxss";

.about-page {
  background:
    radial-gradient(88% 42% at 100% 0%, rgba(68, 158, 236, 0.24), rgba(68, 158, 236, 0) 72%),
    linear-gradient(180deg, #edf8ff 0%, #f8fbfe 54%, #eef5fa 100%);
}

.about-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 16rpx;
  padding: 30rpx 24rpx;
  border: 1rpx solid rgba(111, 172, 226, 0.42);
  border-radius: 26rpx;
  background:
    radial-gradient(74% 120% at 102% 8%, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 52%),
    linear-gradient(132deg, #f9fdff 0%, #e2f2ff 45%, #c9e6ff 100%);
  box-shadow: 0 14rpx 34rpx rgba(38, 102, 163, 0.1);
}

.brand-orbit {
  position: absolute;
  top: -44rpx;
  right: -22rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.78;
}

.brand-shape {
  position: absolute;
  border: 2rpx solid rgba(49, 131, 204, 0.34);
}

.brand-shape-a {
  top: 32rpx;
  left: 20rpx;
  width: 156rpx;
  height: 156rpx;
  border-radius: 42rpx;
  transform: rotate(23deg);
}

.brand-shape-b {
  top: 69rpx;
  left: 57rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
}

.brand-symbol {
  position: absolute;
  top: 84rpx;
  left: 70rpx;
  color: #247fc7;
  font-size: 66rpx;
  font-weight: 700;
  line-height: 1;
}

.about-title {
  position: relative;
  display: block;
  max-width: 78%;
  margin-top: 8rpx;
  color: #0b477d;
  font-size: 45rpx;
  font-weight: 820;
  line-height: 1.24;
  letter-spacing: 1rpx;
}

.about-subtitle {
  position: relative;
  display: block;
  margin-top: 10rpx;
  color: #3f6888;
  font-size: 25rpx;
  line-height: 1.55;
}

.about-section {
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 21rpx 22rpx;
  border: 1rpx solid rgba(102, 164, 221, 0.34);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 26rpx rgba(42, 106, 166, 0.07);
}

.section-title-row {
  display: flex;
  align-items: center;
}

.about-index {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 32rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  background: #e0f1ff;
  color: #1771bd;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.about-section-title {
  color: #104a7c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.problem-list {
  margin-top: 14rpx;
}

.problem-card {
  display: flex;
  align-items: flex-start;
  padding: 14rpx;
  border: 1rpx solid rgba(154, 196, 232, 0.38);
  border-radius: 16rpx;
  background: #f8fcff;
}

.problem-card + .problem-card {
  margin-top: 9rpx;
}

.problem-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 13rpx;
  border-radius: 14rpx;
  background: linear-gradient(145deg, #dff1ff, #cce7ff);
  color: #146fbb;
  font-size: 22rpx;
  font-weight: 800;
}

.problem-copy {
  flex: 1;
  min-width: 0;
}

.problem-title {
  display: block;
  color: #1b527e;
  font-size: 25rpx;
  font-weight: 780;
  line-height: 1.4;
}

.problem-description {
  display: block;
  margin-top: 4rpx;
  color: #536f84;
  font-size: 22rpx;
  line-height: 1.58;
}

.version-section {
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.98), rgba(241, 249, 255, 0.96));
}

.version-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 15rpx 16rpx;
  border-radius: 16rpx;
  background: #edf8ff;
}

.version-name {
  display: block;
  color: #154e7d;
  font-size: 26rpx;
  font-weight: 780;
  line-height: 1.4;
}

.version-positioning {
  display: block;
  margin-top: 4rpx;
  color: #617e94;
  font-size: 21rpx;
  line-height: 1.4;
}

.version-badge {
  flex: none;
  padding: 7rpx 13rpx;
  border: 1rpx solid #a9d4f3;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0e68b3;
  font-size: 22rpx;
  font-weight: 800;
}

.version-sync-note {
  display: block;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #d5e4ef;
  color: #607c91;
  font-size: 20rpx;
  line-height: 1.55;
}

.version-block {
  margin-top: 15rpx;
}

.version-label {
  display: block;
  color: #3d6a8b;
  font-size: 21rpx;
  font-weight: 800;
}

.feature-list,
.update-list {
  margin-top: 8rpx;
}

.feature-item,
.update-item {
  display: flex;
  align-items: flex-start;
}

.feature-item + .feature-item,
.update-item + .update-item {
  margin-top: 7rpx;
}

.feature-dot {
  flex: none;
  width: 9rpx;
  height: 9rpx;
  margin-top: 14rpx;
  margin-right: 11rpx;
  border-radius: 50%;
  background: #3494dc;
}

.feature-text,
.update-text {
  flex: 1;
  color: #455f73;
  font-size: 22rpx;
  line-height: 1.58;
}

.update-block {
  padding-top: 14rpx;
  border-top: 1rpx dashed #d5e4ef;
}

.update-index {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-top: 3rpx;
  margin-right: 9rpx;
  border-radius: 8rpx;
  background: #dceeff;
  color: #226da6;
  font-size: 16rpx;
  font-weight: 800;
}

.team-copy {
  display: block;
  margin-top: 12rpx;
  color: #405d73;
  font-size: 25rpx;
  line-height: 1.7;
}

.contact-list {
  margin-top: 12rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e9f1f7;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-copy {
  flex: 1;
  min-width: 0;
}

.contact-title {
  display: block;
  color: #1d557f;
  font-size: 24rpx;
  font-weight: 780;
}

.contact-description {
  display: block;
  margin-top: 3rpx;
  color: #627b8e;
  font-size: 21rpx;
  line-height: 1.5;
}

.contact-value {
  display: block;
  margin-top: 4rpx;
  color: #146bb4;
  font-size: 21rpx;
  word-break: break-all;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  min-height: 0;
  margin: 4rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #146bb4;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.5;
  text-align: left;
}

.contact-link::after {
  border: none;
}

.contact-link-hover {
  color: #075b9f;
  text-decoration: underline;
}

.contact-status {
  display: block;
  align-self: flex-start;
  margin-top: 5rpx;
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  background: #f0f4f7;
  color: #748795;
  font-size: 18rpx;
}

.contact-note {
  display: block;
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #f6f9fb;
  color: #7a8b98;
  font-size: 19rpx;
  line-height: 1.5;
}

@media (min-width: 700px) {
  .about-hero {
    padding: 20px 22px;
    border-radius: 17px;
  }

  .about-title {
    font-size: 28px;
  }

  .about-subtitle {
    font-size: 14px;
  }

  .about-section {
    margin-top: 10px;
    padding: 15px 16px;
    border-radius: 14px;
  }

  .about-section-title {
    font-size: 18px;
  }

  .problem-card {
    padding: 10px;
    border-radius: 10px;
  }

  .problem-title,
  .version-name,
  .contact-title {
    font-size: 15px;
  }

  .problem-description,
  .feature-text,
  .update-text,
  .team-copy,
  .contact-description {
    font-size: 14px;
  }

  .contact-row {
    padding: 10px 0;
  }
}

@media (max-width: 360px) {
  .about-title {
    max-width: 82%;
    font-size: 40rpx;
  }

  .problem-description,
  .feature-text,
  .update-text {
    font-size: 21rpx;
  }

}
