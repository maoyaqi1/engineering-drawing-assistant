.perpendicular-page {
  --page-navy: #183b5d;
  --page-blue: #267fc4;
  --page-line: #d7e6f2;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background:
    radial-gradient(86% 38% at 100% 0%, rgba(104, 188, 245, 0.22), rgba(104, 188, 245, 0) 70%),
    linear-gradient(180deg, #edf8ff 0%, #f7fbfe 52%, #edf5fb 100%);
  color: var(--page-navy);
}

.page-content {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
  padding: 8rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
}

.knowledge-card {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  box-sizing: border-box;
  border: 1rpx solid var(--page-line);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 22rpx rgba(39, 101, 151, 0.08);
}

.knowledge-card + .knowledge-card {
  margin-top: 8rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 12rpx 3rpx;
}

.condition-index {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 9rpx;
  background: #167bc0;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
}

.second-index {
  background: #c78223;
}

.card-heading-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.card-title {
  color: #174568;
  font-size: 28rpx;
  font-weight: 800;
}

.reference-diagram {
  display: block;
  box-sizing: border-box;
  width: calc(100% - 20rpx);
  margin: 0 10rpx;
  border: 1rpx solid #dbeaf5;
  border-radius: 15rpx;
  background: #ffffff;
}

.rule-box {
  margin: 5rpx 10rpx 0;
  padding: 6rpx 10rpx;
  border-left: 5rpx solid #2b8aca;
  border-radius: 4rpx 9rpx 9rpx 4rpx;
  background: #eff8ff;
}

.second-rule {
  border-left-color: #d18b2c;
  background: #fff8ec;
}

.rule-label {
  display: block;
  color: #2477ac;
  font-size: 19rpx;
  font-weight: 800;
}

.second-rule .rule-label {
  color: #a56817;
}

.rule-text {
  display: block;
  margin-top: 2rpx;
  color: #244d6b;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.38;
}

.theorem-block {
  margin-top: 6rpx;
  padding: 5rpx 8rpx;
  border-radius: 7rpx;
  background: #dff5dc;
}

.theorem-label {
  display: block;
  color: #246c3b;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
}

.theorem-text {
  display: block;
  margin-top: 2rpx;
  color: #28583a;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.36;
}

.video-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 4rpx 10rpx 7rpx;
}

.video-button {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  align-self: stretch;
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 46rpx;
  margin: 0;
  padding: 4rpx 10rpx;
  border: 1rpx solid #9bc9ea;
  border-radius: 13rpx;
  background: linear-gradient(135deg, #e9f6ff, #f8fcff);
  color: #155c91;
  line-height: 1.2;
  text-align: left;
}

.second-video {
  border-color: #e6c18e;
  background: linear-gradient(135deg, #fff6e8, #fffdf9);
  color: #865714;
}

.video-play {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #167fc5;
  color: #ffffff;
  font-size: 13rpx;
  line-height: 1;
}

.second-video .video-play {
  background: #c98524;
}

.video-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.video-title {
  font-size: 20rpx;
  font-weight: 750;
}

.video-source {
  margin-top: 1rpx;
  color: #6f8ca0;
  font-size: 17rpx;
}

.second-video .video-source {
  color: #9b7548;
}

.video-arrow {
  flex: none;
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
}

@media (min-width: 700px) {
  .page-content {
    padding: 6px 16px 10px;
  }

  .knowledge-card + .knowledge-card {
    margin-top: 6px;
  }

  .card-heading {
    padding: 6px 12px 3px;
  }

  .rule-box {
    margin-right: 10px;
    margin-left: 10px;
  }

  .video-row {
    padding: 4px 10px 7px;
  }
}

@media (max-height: 680px) {
  .card-heading {
    padding-top: 4rpx;
  }

  .rule-box {
    margin-top: 4rpx;
    padding-top: 4rpx;
    padding-bottom: 4rpx;
  }

  .rule-text {
    font-size: 20rpx;
    line-height: 1.32;
  }

  .theorem-text {
    font-size: 18rpx;
    line-height: 1.3;
  }
}
