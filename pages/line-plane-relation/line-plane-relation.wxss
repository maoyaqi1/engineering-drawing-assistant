.lesson-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #eef3f8;
  color: #203146;
}

.lesson-scroll {
  flex: 1;
  min-height: 0;
}

.selector-card,
.canvas-card,
.guide-card {
  margin: 8px 14px 0;
  border: 1px solid #dce5ef;
  border-radius: 14px;
  background: #fff;
}

.selector-card {
  display: flex;
  align-items: center;
  margin-top: 4px;
  padding: 4px 7px;
  gap: 6px;
}

.selector-group {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 5px;
  min-width: 0;
}

.selector-label {
  flex: none;
  color: #40546b;
  font-size: 9px;
  font-weight: 700;
}

.selector-picker {
  flex: 1;
  min-width: 0;
}

.selector-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
  box-sizing: border-box;
  min-width: 0;
  height: 27px;
  padding: 0 6px;
  border: 1px solid #6fa9e8;
  border-radius: 5px;
  background: #f2f8ff;
  color: #176bb7;
  font-size: 9.5px;
  font-weight: 650;
  white-space: nowrap;
}

.selector-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selector-arrow {
  flex: none;
  color: #2d8ee8;
  font-size: 11px;
}

.selector-divider {
  flex: none;
  width: 1px;
  height: 21px;
  background: #dce5ef;
}

.canvas-card {
  margin-top: 4px;
  padding: 3px;
  box-shadow: 0 6px 18px rgba(24, 50, 83, 0.09);
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 22px;
  margin-bottom: 1px;
  padding: 0 3px;
}

.card-title {
  min-width: 0;
  color: #26384d;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.reset-button {
  flex: none;
  box-sizing: border-box;
  width: 44px;
  height: 22px;
  margin: 0;
  margin-left: auto;
  padding: 0 6px;
  border: 1px solid #cad8e7;
  border-radius: 6px;
  background: #edf4f8;
  color: #245a75;
  font-size: 10px;
  line-height: 20px;
  text-align: center;
}

.geometry-canvas {
  display: block;
  width: 100%;
  height: 460px;
  border-radius: 11px;
  background: #f8fbff;
}

.guide-card {
  margin-bottom: 8px;
  padding: 12px;
  box-shadow: 0 5px 16px rgba(24, 50, 83, 0.06);
}

.guide-card.complete {
  border-color: #efb5b1;
  background: #fff8f7;
}

.guide-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.guide-heading-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.guide-kicker {
  color: #718196;
  font-size: 9px;
  letter-spacing: 0.6px;
}

.guide-title {
  margin-top: 2px;
  color: #263f5a;
  font-size: 15px;
  font-weight: 800;
}

.guide-progress {
  flex: none;
  color: #176bb7;
  font-size: 15px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.progress-dots {
  display: flex;
  gap: 5px;
  margin-top: 9px;
}

.progress-dot {
  flex: 1;
  height: 4px;
  border-radius: 999px;
  background: #dce4ec;
}

.progress-dot.current {
  background: #8bc3f5;
}

.progress-dot.done {
  background: #2d8ee8;
}

.guide-description {
  display: block;
  margin-top: 9px;
  color: #516276;
  font-size: 11px;
  line-height: 1.55;
}

.auxiliary-choice {
  margin-top: 9px;
  padding: 8px;
  border-radius: 8px;
  background: #f4f7fa;
}

.auxiliary-choice-label {
  display: block;
  color: #65758a;
  font-size: 9.5px;
}

.auxiliary-choice-row {
  display: flex;
  gap: 6px;
  margin-top: 6px;
}

.auxiliary-choice-chip {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 30px;
  margin: 0;
  padding: 0 5px;
  border: 1px solid #ccd8e4;
  border-radius: 6px;
  background: #fff;
  color: #536579;
  font-size: 9.5px;
  line-height: 28px;
}

.auxiliary-choice-chip.recommended {
  border-color: #e3ad43;
}

.auxiliary-choice-chip.active {
  border-color: #1684ff;
  background: #eaf4ff;
  color: #0877dd;
  font-weight: 700;
  box-shadow: inset 0 0 0 1px #1684ff;
}

.recommend-tag {
  padding: 1px 3px;
  border-radius: 999px;
  background: #fff0c9;
  color: #986712;
  font-size: 7.5px;
  font-weight: 700;
  line-height: 1.3;
}

.guide-action {
  width: 100%;
  height: 36px;
  margin: 10px 0 0;
  padding: 0 10px;
  border: 1px solid #1684ff;
  border-radius: 7px;
  background: #1684ff;
  color: #fff;
  font-size: 12px;
  font-weight: 750;
  line-height: 34px;
}

.guide-action.disabled {
  border-color: #e9b0ac;
  background: #fff1f0;
  color: #b63b36;
}

@media (min-width: 500px) {
  .selector-card,
  .canvas-card,
  .guide-card {
    margin-right: 20px;
    margin-left: 20px;
  }

  .geometry-canvas {
    height: 420px;
  }
}
