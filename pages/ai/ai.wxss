.ai-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #eef3f8;
}

.chat {
  flex: 1;
  min-height: 0;
  padding: 20rpx 20rpx 8rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.msg.user {
  justify-content: flex-end;
}

.msg.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 82%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg.user .bubble {
  background: #087df0;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg.assistant .bubble {
  background: #ffffff;
  color: #172438;
  border-top-left-radius: 4rpx;
  box-shadow: 0 4rpx 14rpx rgba(36, 55, 82, 0.06);
}

.ai-avatar {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  display: block;
  background: transparent;
  box-shadow: 0 4rpx 12rpx rgba(43, 124, 240, 0.22);
}

.ai-avatar.lg {
  width: 84rpx;
  height: 84rpx;
  margin-right: 16rpx;
}

.welcome {
  padding: 4rpx 4rpx 20rpx;
}

.welcome-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.welcome-meta {
  display: flex;
  flex-direction: column;
}

.welcome-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #16223a;
  line-height: 1.4;
}

.welcome-sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #6b7a93;
  line-height: 1.5;
}

.quick-questions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.q-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(109, 130, 156, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(36, 55, 82, 0.05);
}

.q-text {
  flex: 1;
  min-width: 0;
  color: #26334a;
  font-size: 26rpx;
  line-height: 1.5;
}

.q-arrow {
  flex: none;
  margin-left: 14rpx;
  color: #9aa6bd;
  font-size: 36rpx;
  font-weight: 700;
}

.notice {
  margin: 0 20rpx 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff4e5;
  color: #a86a00;
  font-size: 26rpx;
  line-height: 1.5;
}

.quick-row {
  display: flex;
  gap: 10rpx;
  padding: 0 20rpx 8rpx;
  box-sizing: border-box;
}

.quick-chip {
  flex: 1;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  background: #eef5ff;
  color: #0e5fa8;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d4d8de;
  background: #ffffff;
}

.input {
  flex: 1;
  min-height: 88rpx;
  max-height: 420rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #d4d8de;
  border-radius: 12rpx;
  background: #f7f9fb;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.send {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #1684ff;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(22, 132, 255, 0.4);
}

.send[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.new {
  flex: none;
  min-width: 112rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #edf4f8;
  color: #245a75;
  font-size: 26rpx;
}

.img-btn {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  background: #edf4f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.image-preview {
  margin: 0 20rpx 8rpx;
  padding: 8rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #d4d8de;
  position: relative;
}

.preview-img {
  width: 100%;
  border-radius: 8rpx;
  display: block;
}

.preview-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 28rpx;
}

.preview-tip {
  display: block;
  margin-top: 6rpx;
  color: #9aa3ad;
  font-size: 22rpx;
}

.msg-image {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: block;
}

/* ---- 宽屏适配（PAD / 折叠屏 / 横屏）：文字与控件保持与手机等大 ----
   rpx 会随窗口宽度放大，这里按 1rpx = 0.5px 换算成 px，使大屏上的字号、间距、按钮与手机一致。 */
@media (min-width: 500px) {
  .chat { padding: 10px 10px 4px; }
  .msg { margin-bottom: 9px; }
  .bubble { padding: 8px 10px; border-radius: 8px; font-size: 14px; }
  .msg.user .bubble { border-top-right-radius: 2px; }
  .msg.assistant .bubble { border-top-left-radius: 2px; box-shadow: 0 2px 7px rgba(36, 55, 82, 0.06); }
  .ai-avatar { width: 30px; height: 30px; margin-right: 6px; box-shadow: 0 2px 6px rgba(43, 124, 240, 0.22); }
  .ai-avatar.lg { width: 42px; height: 42px; margin-right: 8px; }
  .welcome { padding: 2px 2px 10px; }
  .welcome-head { margin-bottom: 12px; }
  .welcome-title { font-size: 17px; }
  .welcome-sub { margin-top: 3px; font-size: 12.5px; }
  .quick-questions { gap: 6px; }
  .q-card { padding: 11px 11px; border-radius: 7px; border: 0.5px solid rgba(109, 130, 156, 0.12); box-shadow: 0 2px 6px rgba(36, 55, 82, 0.05); }
  .q-text { font-size: 13px; }
  .q-arrow { margin-left: 7px; font-size: 18px; }
  .notice { margin: 0 10px 6px; padding: 8px 10px; border-radius: 6px; font-size: 13px; }
  .quick-row { gap: 5px; padding: 0 10px 4px; }
  .quick-chip { padding: 6px 4px; border-radius: 6px; font-size: 12px; }
  .input-bar { gap: 6px; padding: 7px 10px calc(10px + env(safe-area-inset-bottom)); border-top: 0.5px solid #d4d8de; }
  .input { min-height: 44px; max-height: 210px; padding: 7px 9px; border: 0.5px solid #d4d8de; border-radius: 6px; font-size: 14px; }
  .send { width: 38px; height: 38px; min-width: 38px; line-height: 38px; font-size: 17px; box-shadow: 0 3px 7px rgba(22, 132, 255, 0.4); }
  .new { min-width: 56px; height: 38px; line-height: 38px; padding: 0 10px; border-radius: 7px; font-size: 13px; }
  .img-btn { width: 32px; height: 32px; margin-right: 4px; border-radius: 5px; font-size: 16px; }
  .image-preview { margin: 0 10px 4px; padding: 4px; border-radius: 5px; border: 0.5px solid #d4d8de; }
  .preview-img { border-radius: 4px; }
  .preview-remove { top: 3px; right: 3px; width: 20px; height: 20px; line-height: 17px; font-size: 14px; }
  .preview-tip { margin-top: 3px; font-size: 11px; }
  .msg-image { border-radius: 4px; margin-bottom: 4px; }
}
