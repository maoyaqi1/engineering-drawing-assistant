.teacher-shell {
  min-height: 100vh;
  background: #eef3f8;
  color: #1f2a3a;
  padding-bottom: 40rpx;
}

/* ---- 登录 ---- */
.login-view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}
.login-card {
  width: 100%;
  max-width: 460px;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(31,42,58,0.06);
}
.login-brand { display: flex; align-items: center; gap: 20rpx; margin-bottom: 40rpx; }
.login-logo {
  width: 76rpx; height: 76rpx; border-radius: 20rpx;
  background: #2f6fed; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; font-weight: 700;
}
.brand-text { font-size: 32rpx; font-weight: 700; display: flex; flex-direction: column; }
.brand-sub { font-size: 22rpx; color: #6a7688; font-weight: 400; margin-top: 6rpx; }

.field { margin-bottom: 28rpx; }
.label { display: block; font-size: 24rpx; color: #6a7688; margin-bottom: 12rpx; }
.input {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e3e9f1;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}
.login-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.login-btn::after { border: none; }
.login-error { margin-top: 20rpx; font-size: 24rpx; color: #e04444; }
.login-tip { margin-top: 28rpx; font-size: 22rpx; color: #6a7688; line-height: 1.6; }

/* ---- 工作台 ---- */
.workbench { padding: 24rpx; }
.workbench-inner {
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
}
.wb-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.wb-title { font-size: 34rpx; font-weight: 700; }

.wb-profile {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx;
}
.avatar {
  width: 68rpx; height: 68rpx; border-radius: 18rpx;
  background: #2f6fed; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700;
}
.wb-profile .info { flex: 1; }
.wb-profile .name { font-size: 30rpx; font-weight: 700; display: flex; align-items: center; gap: 12rpx; }
.role {
  font-size: 20rpx; color: #2f6fed; background: #eaf1ff;
  padding: 4rpx 14rpx; border-radius: 20rpx; font-weight: 500;
}
.wb-profile .meta { font-size: 22rpx; color: #6a7688; margin-top: 6rpx; }
.logout-btn {
  padding: 14rpx 22rpx; border-radius: 14rpx;
  background: #fff; border: 1rpx solid #e3e9f1; color: #6a7688;
  font-size: 24rpx;
}
.logout-btn::after { border: none; }

.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }
.add-btn {
  padding: 12rpx 24rpx; border-radius: 14rpx;
  background: #2f6fed; color: #fff; font-size: 24rpx; font-weight: 600;
}
.add-btn::after { border: none; }

.card { background: #fff; border-radius: 20rpx; padding: 24rpx; }
.thead { display: flex; align-items: center; color: #6a7688; font-size: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #eef3f8; }
.trow { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f4f7fb; font-size: 26rpx; }
.col-1 { flex: 1.2; }
.col-2 { flex: 1.6; white-space: nowrap; }
.col-3 { flex: 0.8; }
.col-4 { flex: 2.4; display: flex; justify-content: flex-end; }
.status { font-weight: 600; }
.status.active { color: #1a9a4b; }
.status.inactive { color: #e04444; }
.ops { display: flex; gap: 12rpx; }
.mini-btn {
  padding: 10rpx 18rpx; border-radius: 12rpx;
  background: #f4f7fb; color: #3a4a5e; font-size: 22rpx;
  line-height: 1.6; margin: 0;
}
.mini-btn::after { border: none; }
.mini-btn.danger { color: #e04444; }
.empty { text-align: center; color: #9aa5b2; padding: 40rpx 0; font-size: 26rpx; }
.notice { text-align: center; color: #6a7688; font-size: 26rpx; padding: 48rpx 24rpx; line-height: 1.6; }

/* ---- 输入弹层 ---- */
.prompt-mask {
  position: fixed; inset: 0; background: rgba(31,42,58,0.4);
  display: flex; align-items: center; justify-content: center; z-index: 999;
}
.prompt-card {
  width: 560rpx; background: #fff; border-radius: 20rpx; padding: 32rpx;
}
.prompt-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.prompt-input { margin-bottom: 24rpx; }
.prompt-ops { display: flex; gap: 20rpx; }
.prompt-ops .mini-btn { flex: 1; padding: 20rpx; text-align: center; }
.prompt-ok { margin: 0; }

/* ---- 导航 ---- */
.nav-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.nav-pill {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  background: #fff; color: #4a5a6e; font-size: 26rpx;
  border: 1rpx solid #e3e9f1; line-height: 1.4; margin: 0;
}
.nav-pill::after { border: none; }
.nav-pill.active { background: #2f6fed; color: #fff; border-color: #2f6fed; font-weight: 600; }

/* ---- 驾驶舱统计 ---- */
.stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.stat-card {
  background: #fff; border-radius: 20rpx; padding: 26rpx 24rpx;
  border-left: 6rpx solid #2f6fed;
}
.stat-num { font-size: 46rpx; font-weight: 700; color: #1f2a3a; }
.stat-label { font-size: 24rpx; color: #6a7688; margin-top: 6rpx; }

.card-title { font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.trend-chart { display: flex; align-items: flex-end; gap: 10rpx; height: 260rpx; padding-bottom: 8rpx; }
.trend-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6rpx; }
.trend-bar-plp { width: 22rpx; background: #2f6fed; border-radius: 6rpx; min-height: 4rpx; }
.trend-bar-active { width: 22rpx; background: #34c77b; border-radius: 6rpx; min-height: 4rpx; }
.trend-date { font-size: 18rpx; color: #9aa5b2; }
.trend-legend { display: flex; align-items: center; gap: 20rpx; margin-top: 14rpx; font-size: 22rpx; color: #6a7688; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; display: inline-block; margin-right: 6rpx; }
.legend-dot.plp { background: #2f6fed; }
.legend-dot.active { background: #34c77b; }

@media (min-width: 900px) {
  .stat-grid { grid-template-columns: repeat(4, 1fr); }
  .nav-bar { gap: 16rpx; }
}
