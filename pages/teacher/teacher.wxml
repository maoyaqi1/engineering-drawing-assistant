<view class="teacher-shell">

  <!-- 登录视图 -->
  <view wx:if="{{!loggedIn}}" class="login-view">
    <view class="login-card">
      <view class="login-brand">
        <view class="login-logo">图</view>
        <view class="brand-text">教师端管理后台<text class="brand-sub">工程制图学习助手 · 教学驾驶舱</text></view>
      </view>
      <view class="field">
        <text class="label">账号</text>
        <input class="input" placeholder="请输入教师账号" value="{{username}}" bindinput="onUsername" />
      </view>
      <view class="field">
        <text class="label">密码</text>
        <input class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onPassword" />
      </view>
      <button class="login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="doLogin">登 录</button>
      <view wx:if="{{error}}" class="login-error">{{error}}</view>
      <view class="login-tip">请先部署 teacher 云函数并配置 TEACHER_USERNAME / TEACHER_PASSWORD</view>
    </view>
  </view>

  <!-- 后台工作台 -->
  <view wx:else class="workbench">
    <view class="workbench-inner">
      <view class="wb-top">
        <view class="wb-title">教师端管理后台</view>
        <button class="mini-btn" bindtap="goHome">返回学生端</button>
      </view>

      <view class="wb-profile">
        <view class="avatar">{{teacher.name[0]}}</view>
        <view class="info">
          <view class="name">{{teacher.name}}<text class="role">{{isSuper ? '超级管理员' : '教师'}}</text></view>
          <view class="meta">账号：{{teacher.username}}</view>
        </view>
        <button class="logout-btn" bindtap="doLogout">退出登录</button>
      </view>

      <!-- 导航 -->
      <view class="nav-bar">
        <button
          wx:for="{{navItems}}"
          wx:key="key"
          class="nav-pill {{view === item.key ? 'active' : ''}}"
          data-view="{{item.key}}"
          bindtap="switchView"
        >{{item.label}}</button>
      </view>

      <!-- 驾驶舱 -->
      <block wx:if="{{view === 'dashboard'}}">
        <view class="stat-grid">
          <view class="stat-card">
            <view class="stat-num">{{dash.total_students || 0}}</view>
            <view class="stat-label">学生总数</view>
          </view>
          <view class="stat-card">
            <view class="stat-num">{{dash.today_active_students || 0}}</view>
            <view class="stat-label">今日活跃</view>
          </view>
          <view class="stat-card">
            <view class="stat-num">{{dash.plp_today || 0}}</view>
            <view class="stat-label">点线面今日</view>
          </view>
          <view class="stat-card">
            <view class="stat-num">{{dash.ai_today || 0}}</view>
            <view class="stat-label">AI提问今日</view>
          </view>
        </view>
        <view class="card">
          <view class="card-title">近 7 天学习趋势</view>
          <view class="trend-chart">
            <view class="trend-col" wx:for="{{dash.trend}}" wx:key="date">
              <view class="trend-bar-plp" style="height: {{item.plp * 6}}rpx"></view>
              <view class="trend-bar-active" style="height: {{item.active * 6}}rpx"></view>
              <view class="trend-date">{{item.date}}</view>
            </view>
          </view>
          <view class="trend-legend">
            <text class="legend-dot plp"></text>点线面
            <text class="legend-dot active"></text>活跃人数
          </view>
        </view>
      </block>

      <!-- 学生管理 -->
      <block wx:elif="{{view === 'students'}}">
        <view class="card notice">学生管理将在后续阶段上线。</view>
      </block>

      <!-- 点线面分析 -->
      <block wx:elif="{{view === 'plp'}}">
        <view class="card notice">点线面分析将在后续阶段上线。</view>
      </block>

      <!-- AI 教师分析 -->
      <block wx:elif="{{view === 'ai'}}">
        <view class="card notice">AI 教师分析将在后续阶段上线。</view>
      </block>

      <!-- 教师管理 -->
      <block wx:elif="{{view === 'teachers'}}">
        <view class="section-head">
          <text class="section-title">教师管理</text>
          <button wx:if="{{isSuper}}" class="add-btn" bindtap="addTeacher">+ 新增教师</button>
        </view>
        <view class="card">
          <view class="thead">
            <text class="col-1">账号</text>
            <text class="col-2">姓名</text>
            <text class="col-3">状态</text>
            <text class="col-4">操作</text>
          </view>
          <view class="trow" wx:for="{{teachers}}" wx:key="id">
            <text class="col-1">{{item.username}}</text>
            <text class="col-2">{{item.name}}</text>
            <text class="col-3 status {{item.status}}">{{item.status === 'active' ? '启用' : '停用'}}</text>
            <view class="col-4 ops">
              <button class="mini-btn" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggleTeacher">{{item.status === 'active' ? '停用' : '启用'}}</button>
              <button class="mini-btn" data-id="{{item.id}}" bindtap="resetTeacherPassword">改密</button>
              <block wx:if="{{item.role !== 'super_admin'}}">
                <button class="mini-btn danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="deleteTeacher">删除</button>
              </block>
            </view>
          </view>
          <view wx:if="{{teachers.length === 0}}" class="empty">暂无教师账号</view>
        </view>
      </block>

      <view wx:else class="card notice">
        设置等功能将在后续阶段上线。
      </view>
    </view>
  </view>

  <!-- 输入弹层 -->
  <view wx:if="{{promptVisible}}" class="prompt-mask">
    <view class="prompt-card">
      <view class="prompt-title">{{promptTitle}}</view>
      <input class="input prompt-input" placeholder="请输入" value="{{promptValue}}" bindinput="onPromptInput" focus="{{promptVisible}}" />
      <view class="prompt-ops">
        <button class="mini-btn" bindtap="cancelPrompt">取消</button>
        <button class="login-btn prompt-ok" bindtap="confirmPrompt">确定</button>
      </view>
    </view>
  </view>

</view>
