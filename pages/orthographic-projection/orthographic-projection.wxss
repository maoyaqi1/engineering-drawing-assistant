.lesson-shell {
  --lesson-navy: #0b417a;
  --lesson-blue: #126fd3;
  --lesson-line: rgba(103, 169, 228, 0.38);
  --lesson-muted: #617f9b;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(84% 46% at 104% 0%, rgba(96, 181, 255, 0.28), rgba(96, 181, 255, 0) 66%),
    linear-gradient(180deg, #e8f5ff 0%, #f8fcff 42%, #edf8ff 100%);
  color: var(--lesson-navy);
}

.page-topbar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 58rpx;
  padding: 5rpx 20rpx;
  border-bottom: 1rpx solid rgba(89, 153, 209, 0.2);
  background: rgba(244, 250, 255, 0.9);
}

.home-entry {
  color: #1265b0;
  font-size: 20rpx;
  font-weight: 700;
}

.page-topbar-title {
  color: #597690;
  font-size: 19rpx;
  font-weight: 600;
}

.lesson-scroll {
  flex: 1;
  height: 0;
}

.content {
  box-sizing: border-box;
  width: 100%;
  max-width: 1040px;
  margin: 0 auto;
  padding: 10rpx 16rpx calc(22rpx + env(safe-area-inset-bottom));
}

.lesson-card {
  box-sizing: border-box;
  border: 1rpx solid var(--lesson-line);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 7rpx 20rpx rgba(36, 105, 170, 0.08);
  padding: 14rpx;
}

.lesson-card + .lesson-card {
  margin-top: 10rpx;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-heading > view:first-child {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.section-title {
  color: #0c467f;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.3;
}

.section-lead {
  display: block;
  margin-top: 4rpx;
  color: var(--lesson-muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.demo-canvas {
  display: block;
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  border: 1rpx solid rgba(91, 153, 208, 0.3);
  border-radius: 18rpx;
  background: #f7fbff;
}

.relation-canvas {
  height: 760rpx;
}

.replay-button {
  flex: none;
  height: 48rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #75b6e9;
  border-radius: 999rpx;
  background: #e7f5ff;
  color: #1265b0;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.relation-tabs {
  display: flex;
  gap: 7rpx;
  margin-top: 10rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #ecf5fc;
}

.relation-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 80rpx;
  margin: 0;
  padding: 3rpx 4rpx;
  border: 0;
  border-radius: 11rpx;
  background: transparent;
  line-height: 1.2;
}

.relation-tab.active {
  background: #ffffff;
  box-shadow: 0 4rpx 11rpx rgba(29, 93, 151, 0.12);
}

.relation-symbol {
  color: #315f86;
  font-size: 20rpx;
  font-weight: 750;
}

.relation-property {
  margin-top: 3rpx;
  color: #6a8398;
  font-size: 24rpx;
  font-weight: 750;
}

.relation-tab.active .relation-symbol,
.relation-tab.active .relation-property {
  color: #0b66bb;
}

.result-card {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #d8eafa;
  border-radius: 14rpx;
  background: #f8fcff;
}

.result-heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.result-property {
  flex: none;
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
  background: #166fbe;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 750;
}

.result-condition {
  color: #315d7e;
  font-size: 19rpx;
  font-weight: 650;
}

.result-row {
  display: flex;
  align-items: flex-start;
  gap: 9rpx;
  margin-top: 4rpx;
}

.result-label {
  flex: none;
  min-width: 150rpx;
  color: #51708a;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.45;
}

.result-text {
  color: #284d6b;
  font-size: 18rpx;
  line-height: 1.45;
}

.measure-row {
  display: flex;
  gap: 7rpx;
  flex-wrap: wrap;
  margin-top: 7rpx;
}

.measure-chip {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: #e9f5ff;
  color: #17669e;
  font-size: 17rpx;
  font-weight: 650;
}

.similarity-note {
  display: block;
  margin-top: 7rpx;
  padding-top: 6rpx;
  border-top: 1rpx dashed #c8deee;
  color: #6b5a3f;
  font-size: 17rpx;
  line-height: 1.45;
}

.bridge-card {
  margin-top: 8rpx;
  padding: 9rpx 12rpx;
  border-left: 7rpx solid #e6a13d;
  border-radius: 8rpx 13rpx 13rpx 8rpx;
  background: #fff7e9;
}

.bridge-title {
  display: block;
  color: #9b5d0e;
  font-size: 19rpx;
  font-weight: 750;
}

.bridge-copy {
  display: block;
  margin-top: 3rpx;
  color: #795a31;
  font-size: 18rpx;
  line-height: 1.48;
}

.level-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
  color: #637d92;
  font-size: 17rpx;
  line-height: 1.45;
}

.level-note-mark {
  flex: none;
  color: #28689d;
  font-weight: 750;
}

.level-note-copy {
  min-width: 0;
}

@media (min-width: 700px) {
  .content {
    padding: 7px 20px 18px;
  }

  .lesson-card {
    padding: 10px;
    border-radius: 12px;
  }

  .lesson-card + .lesson-card {
    margin-top: 6px;
  }

  .section-title {
    font-size: 19px;
  }

  .section-lead {
    font-size: 12px;
  }

  .relation-canvas {
    height: 440px;
  }

  .replay-button {
    height: 30px;
    padding: 0 9px;
    font-size: 12px;
    line-height: 28px;
  }

  .relation-tabs {
    margin-top: 7px;
    padding: 4px;
  }

  .relation-tab {
    height: 48px;
  }

  .relation-symbol {
    font-size: 13px;
  }

  .relation-property {
    font-size: 15px;
  }
}

@media (max-width: 360px) {
  .content {
    padding-right: 14rpx;
    padding-left: 14rpx;
  }

  .lesson-card {
    padding: 11rpx;
  }

  .result-label {
    min-width: 146rpx;
  }
}
