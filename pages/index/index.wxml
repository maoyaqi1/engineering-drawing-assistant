<view class="page-shell">
  <view class="app-toolbar">
    <view class="profile-entry" bindtap="goProfile">
      <text class="profile-avatar">👤</text>
      <text class="profile-link">个人信息</text>
    </view>
    <picker class="module-picker" mode="selector" range="{{moduleOptions}}" value="{{moduleIndex}}" bindchange="handleModulePicker">
      <view class="module-selector">
        <text>{{moduleOptions[moduleIndex]}}</text>
        <text class="selector-arrow">⌄</text>
      </view>
    </picker>
  </view>

  <scroll-view class="page-scroll" scroll-y="{{!canvasDragging}}" scroll-top="0">
  <view class="type-panel" wx:if="{{mode === 'point'}}">
    <text class="type-label">类型</text>
    <view class="type-toolbar">
      <button class="type-chip {{pointType === 'general' ? 'active' : ''}}" data-type="general" bindtap="handlePointType">一般点</button>
      <button class="type-chip {{pointType === 'origin' ? 'active' : ''}}" data-type="origin" bindtap="handlePointType">原点</button>
      <button class="type-chip {{pointType === 'axisX' ? 'active' : ''}}" data-type="axisX" bindtap="handlePointType">OX轴</button>
      <button class="type-chip {{pointType === 'axisY' ? 'active' : ''}}" data-type="axisY" bindtap="handlePointType">OY轴</button>
      <button class="type-chip {{pointType === 'axisZ' ? 'active' : ''}}" data-type="axisZ" bindtap="handlePointType">OZ轴</button>
      <button class="type-chip {{pointType === 'planeH' ? 'active' : ''}}" data-type="planeH" bindtap="handlePointType">H面</button>
      <button class="type-chip {{pointType === 'planeV' ? 'active' : ''}}" data-type="planeV" bindtap="handlePointType">V面</button>
      <button class="type-chip {{pointType === 'planeW' ? 'active' : ''}}" data-type="planeW" bindtap="handlePointType">W面</button>
    </view>
  </view>

  <view class="type-panel" wx:elif="{{mode === 'line'}}">
    <text class="type-label">类型</text>
    <view class="type-toolbar">
      <button class="type-chip {{lineType === 'general' ? 'active' : ''}}" data-type="general" bindtap="handleLineType">一般线</button>
      <button class="type-chip {{lineType === 'horizontal' ? 'active' : ''}}" data-type="horizontal" bindtap="handleLineType">水平线</button>
      <button class="type-chip {{lineType === 'frontal' ? 'active' : ''}}" data-type="frontal" bindtap="handleLineType">正平线</button>
      <button class="type-chip {{lineType === 'profile' ? 'active' : ''}}" data-type="profile" bindtap="handleLineType">侧平线</button>
      <button class="type-chip {{lineType === 'vertical' ? 'active' : ''}}" data-type="vertical" bindtap="handleLineType">铅垂线</button>
      <button class="type-chip {{lineType === 'frontProjecting' ? 'active' : ''}}" data-type="frontProjecting" bindtap="handleLineType">正垂线</button>
      <button class="type-chip {{lineType === 'profileProjecting' ? 'active' : ''}}" data-type="profileProjecting" bindtap="handleLineType">侧垂线</button>
    </view>
  </view>

  <view class="type-panel" wx:elif="{{mode === 'plane'}}">
    <text class="type-label">类型</text>
    <view class="type-toolbar">
      <button class="type-chip {{planeType === 'general' ? 'active' : ''}}" data-type="general" bindtap="handlePlaneType">一般面</button>
      <button class="type-chip {{planeType === 'horizontal' ? 'active' : ''}}" data-type="horizontal" bindtap="handlePlaneType">水平面</button>
      <button class="type-chip {{planeType === 'frontal' ? 'active' : ''}}" data-type="frontal" bindtap="handlePlaneType">正平面</button>
      <button class="type-chip {{planeType === 'profile' ? 'active' : ''}}" data-type="profile" bindtap="handlePlaneType">侧平面</button>
      <button class="type-chip {{planeType === 'vertical' ? 'active' : ''}}" data-type="vertical" bindtap="handlePlaneType">铅垂面</button>
      <button class="type-chip {{planeType === 'frontProjecting' ? 'active' : ''}}" data-type="frontProjecting" bindtap="handlePlaneType">正垂面</button>
      <button class="type-chip {{planeType === 'profileProjecting' ? 'active' : ''}}" data-type="profileProjecting" bindtap="handlePlaneType">侧垂面</button>
    </view>
  </view>

  <view class="type-panel" wx:elif="{{mode === 'solid'}}">
    <view class="solid-type-tabs">
      <button wx:for="{{solidTypes}}" wx:key="index" class="solid-type-chip {{solidTypeIndex === index ? 'active' : ''}}" data-type="{{index}}" bindtap="handleBasicSolidType">{{item}}</button>
    </view>

    <text class="solid-group-label">尺寸</text>
    <view class="slider-row" wx:if="{{solid.type === 'prism' || solid.type === 'pyramid'}}">
      <text class="param-name">棱数</text>
      <view class="stepper">
        <button class="step-btn" data-delta="-1" bindtap="handleSidesStep">−</button>
        <text class="step-val">{{solid.sides}}</text>
        <button class="step-btn" data-delta="1" bindtap="handleSidesStep">＋</button>
      </view>
    </view>
    <view class="slider-row" wx:if="{{solid.type === 'prism' || solid.type === 'pyramid' || solid.type === 'cylinder' || solid.type === 'cone' || solid.type === 'sphere'}}">
      <text class="param-name">半径</text>
      <slider class="param-slider" min="0.5" max="3" step="0.1" value="{{solid.radius}}" data-key="radius" bindchanging="handleSizeSliderLive" bindchange="handleSizeSlider" activeColor="#1684ff" block-size="16" />
      <text class="param-val">{{solid.radius}}</text>
    </view>
    <view class="slider-row" wx:if="{{solid.type === 'prism' || solid.type === 'pyramid' || solid.type === 'cylinder' || solid.type === 'cone'}}">
      <text class="param-name">高度</text>
      <slider class="param-slider" min="1" max="6" step="0.1" value="{{solid.height}}" data-key="height" bindchanging="handleSizeSliderLive" bindchange="handleSizeSlider" activeColor="#1684ff" block-size="16" />
      <text class="param-val">{{solid.height}}</text>
    </view>
    <view class="slider-row" wx:if="{{solid.type === 'torus'}}">
      <text class="param-name">大圆半径</text>
      <slider class="param-slider" min="1" max="2.5" step="0.1" value="{{solid.majorRadius}}" data-key="majorRadius" bindchanging="handleSizeSliderLive" bindchange="handleSizeSlider" activeColor="#1684ff" block-size="16" />
      <text class="param-val">{{solid.majorRadius}}</text>
    </view>
    <view class="slider-row" wx:if="{{solid.type === 'torus'}}">
      <text class="param-name">小圆半径</text>
      <slider class="param-slider" min="0.2" max="1" step="0.1" value="{{solid.minorRadius}}" data-key="minorRadius" bindchanging="handleSizeSliderLive" bindchange="handleSizeSlider" activeColor="#1684ff" block-size="16" />
      <text class="param-val">{{solid.minorRadius}}</text>
    </view>

    <text class="solid-group-label">姿态</text>
    <view class="pose-tabs">
      <button wx:for="{{poseTabs}}" wx:key="index" class="pose-tab {{poseTabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="handlePoseTab">{{item}}</button>
    </view>

    <block wx:if="{{poseTabIndex === 0 || poseTabIndex === 1}}">
      <view class="axis-row">
        <text class="param-name">坐标轴</text>
        <button wx:for="{{axisLabels}}" wx:key="index" class="axis-chip {{(poseTabIndex === 0 ? rotationAxisIndex : translationAxisIndex) === index ? 'active' : ''}}" data-index="{{index}}" bindtap="handleAxisChip">{{item}}</button>
      </view>
      <view class="slider-row">
        <text class="param-name">{{poseTabIndex === 0 ? '旋转角度' : '平移量'}}</text>
        <slider wx:if="{{poseTabIndex === 0}}" class="param-slider" min="0" max="360" step="1" value="{{rotationValue}}" bindchanging="handleRotationAngleLive" bindchange="handleRotationAngle" activeColor="#e04f54" block-size="16" />
        <slider wx:else class="param-slider" min="{{translationAxis === 'z' ? (solid.type === 'torus' ? solid.minorRadius : (solid.type === 'sphere' ? solid.radius : solid.height / 2)) : (solid.type === 'torus' ? (solid.majorRadius + solid.minorRadius) : solid.radius)}}" max="{{translationAxis === 'z' ? (8 - (solid.type === 'torus' ? solid.minorRadius : (solid.type === 'sphere' ? solid.radius : solid.height / 2))) : (8 - (solid.type === 'torus' ? (solid.majorRadius + solid.minorRadius) : solid.radius))}}" step="0.1" value="{{translationValue}}" bindchanging="handleTranslationLive" bindchange="handleTranslation" activeColor="#1684ff" block-size="16" />
        <text class="param-val">{{poseTabIndex === 0 ? (rotationValue + '°') : translationValue}}</text>
        <button wx:if="{{poseTabIndex === 0}}" class="rot90-chip" bindtap="handleRotate90">旋转90°</button>
      </view>
    </block>
  </view>

  <view class="type-panel" wx:else>
    <text class="type-label">立体</text>
    <view class="type-toolbar solid-toolbar">
      <button class="type-chip {{section.solidType === 'triangularPyramid' ? 'active' : ''}}" data-type="triangularPyramid" bindtap="handleSolidType">三棱锥</button>
      <button class="type-chip {{section.solidType === 'pentagonalPrism' ? 'active' : ''}}" data-type="pentagonalPrism" bindtap="handleSolidType">五棱柱</button>
      <button class="type-chip {{section.solidType === 'cylinder' ? 'active' : ''}}" data-type="cylinder" bindtap="handleSolidType">圆柱</button>
      <button class="type-chip {{section.solidType === 'cone' ? 'active' : ''}}" data-type="cone" bindtap="handleSolidType">圆锥</button>
      <button class="type-chip {{section.solidType === 'sphere' ? 'active' : ''}}" data-type="sphere" bindtap="handleSolidType">圆球</button>
      <button class="type-chip {{section.solidType === 'torus' ? 'active' : ''}}" data-type="torus" bindtap="handleSolidType">圆环</button>
    </view>
    <text class="type-label section-plane-label">截平面</text>
    <view class="type-toolbar section-plane-toolbar">
      <button class="type-chip {{section.planeType === 'horizontal' ? 'active' : ''}}" data-type="horizontal" bindtap="handleSectionPlaneType">水平面</button>
      <button class="type-chip {{section.planeType === 'frontProjecting' ? 'active' : ''}}" data-type="frontProjecting" bindtap="handleSectionPlaneType">正垂面</button>
      <button class="type-chip {{section.planeType === 'profile' ? 'active' : ''}}" data-type="profile" bindtap="handleSectionPlaneType">侧平面</button>
    </view>
    <view class="section-controls">
      <view class="section-control">
        <view class="control-meta"><text>截平面角度</text><text>{{section.angle}}°</text></view>
        <slider min="0" max="180" step="1" value="{{section.angle}}" data-key="angle" bindchanging="handleSectionLive" bindchange="handleSectionSlider" activeColor="#e04f54" block-size="18" />
      </view>
      <view class="section-control">
        <view class="control-meta"><text>平面位置</text><text>{{section.offset}}</text></view>
        <slider min="-3" max="3" step="0.1" value="{{section.offset}}" data-key="offset" bindchanging="handleSectionLive" bindchange="handleSectionSlider" activeColor="#1684ff" block-size="18" />
      </view>
    </view>
  </view>

  <view class="mobile-intro">
    <view>
      <text class="intro-title">{{mode === 'point' ? '点的三面投影' : (mode === 'line' ? '直线的三面投影' : (mode === 'plane' ? '平面的三面投影' : (mode === 'section' ? '平面切割立体' : '基本立体')))}}</text>
      <text class="intro-copy">{{mode === 'point' ? '拖动下方 a、a′、a″，观察空间点同步变化' : (mode === 'line' ? '拖动下方 A、B 的投影点，观察空间直线同步变化' : (mode === 'plane' ? '拖动下方 A、B、C 的投影点，观察空间平面同步变化' : (mode === 'section' ? '选择截平面类型并调整角度和位置，观察截交线变化' : '调整立体参数，观察三视图变化')))}}</text>
    </view>
    <view class="status-pill">第一分角</view>
  </view>

  <view class="canvas-card">
    <view class="card-heading">
      <view>
        <text class="card-title">{{mode === 'point' ? '空间与展开投影' : (mode === 'line' ? '空间直线与三面投影' : (mode === 'plane' ? '空间平面与三面投影' : (mode === 'section' ? '截平面切割与截交线' : '立体与三面投影')))}}</text>
        <text class="card-caption">{{mode === 'point' ? '下方三个投影点均可拖动' : (mode === 'line' ? '下方六个端点投影均可拖动' : (mode === 'plane' ? '下方九个端点投影均可拖动' : (mode === 'section' ? '红色轮廓为实时截交线' : '调整参数，观察 3D 与三视图联动')))}}</text>
      </view>
      <button class="ghost-button" bindtap="resetPoint">重置</button>
    </view>
    <canvas
      id="geometryCanvas"
      type="2d"
      class="geometry-canvas"
      bindtouchstart="handleTouchStart"
      bindtouchmove="handleTouchMove"
      bindtouchend="handleTouchEnd"
      aria-label="空间点与三面投影互动图"
    ></canvas>
    <view class="legend-row" wx:if="{{mode === 'point'}}">
      <view class="legend-item"><text class="legend-dot dot-space"></text>空间点 A</view>
      <view class="legend-item"><text class="legend-dot dot-projection"></text>a、a′、a″</view>
      <view class="legend-item"><text class="legend-line"></text>投射线</view>
    </view>
    <view class="legend-row" wx:elif="{{mode === 'line'}}">
      <view class="legend-item"><text class="legend-dot dot-a"></text>端点 A</view>
      <view class="legend-item"><text class="legend-dot dot-b"></text>端点 B</view>
      <view class="legend-item"><text class="legend-solid"></text>空间直线 AB</view>
      <view class="legend-item"><text class="legend-line"></text>投射线</view>
    </view>
    <view class="legend-row" wx:elif="{{mode === 'plane'}}">
      <view class="legend-item"><text class="legend-dot dot-a"></text>A</view>
      <view class="legend-item"><text class="legend-dot dot-b"></text>B</view>
      <view class="legend-item"><text class="legend-dot dot-c"></text>C</view>
      <view class="legend-item"><text class="legend-plane"></text>空间平面 ABC</view>
    </view>
    <view class="legend-row" wx:elif="{{mode === 'section'}}">
      <view class="legend-item"><text class="legend-solid solid-edge"></text>立体轮廓</view>
      <view class="legend-item"><text class="legend-plane cut-plane"></text>截平面</view>
      <view class="legend-item"><text class="legend-solid section-line"></text>截交线</view>
    </view>
  </view>

  <view class="lesson-card" wx:if="{{mode === 'point'}}">
    <text class="lesson-index">观察 · 01</text>
    <text class="lesson-title">一个空间点，三个二维信息</text>
    <text class="lesson-body">上方类型按钮用于快速显示典型投影位置，不会锁定坐标。拖动 a′ 可改变 X、Z，拖动 a 可改变 X、Y，拖动 a″ 可改变 Y、Z。</text>
    <view class="formula-row">
      <view class="formula-chip">正视 A′ = (X, Z)</view>
      <view class="formula-chip">俯视 A = (X, Y)</view>
      <view class="formula-chip">左视 A″ = (Y, Z)</view>
    </view>
  </view>

  <view class="lesson-card" wx:elif="{{mode === 'line'}}">
    <text class="lesson-index">观察 · 02</text>
    <text class="lesson-title">一条空间直线，三条投影线段</text>
    <text class="lesson-body">直线由 A、B 两点确定。拖动任一端点的正视、俯视或左视投影，可改变该端点对应的两个空间坐标，并实时更新空间直线。</text>
    <view class="formula-row">
      <view class="formula-chip">正视：a′b′</view>
      <view class="formula-chip">俯视：ab</view>
      <view class="formula-chip">左视：a″b″</view>
    </view>
  </view>

  <view class="lesson-card" wx:elif="{{mode === 'plane'}}">
    <text class="lesson-index">观察 · 03</text>
    <text class="lesson-title">三个不共线点确定一个平面</text>
    <text class="lesson-body">空间平面 ABC 在三个投影面上分别形成投影三角形。特殊位置平面的某个投影可能积聚为直线，这正是判断平面位置的重要依据。</text>
    <view class="formula-row">
      <view class="formula-chip">正视：a′b′c′</view>
      <view class="formula-chip">俯视：abc</view>
      <view class="formula-chip">左视：a″b″c″</view>
    </view>
  </view>

  <view class="lesson-card" wx:elif="{{mode === 'solid'}}">
    <text class="lesson-index">观察 · 05</text>
    <text class="lesson-title">改变尺寸与姿态，观察三视图如何同步变化</text>
    <text class="lesson-body">调整「尺寸」改变立体大小，调整「姿态」改变位置与方向，V、H、W 三面投影实时同步。</text>
    <view class="formula-row">
      <view class="formula-chip">红/蓝/绿：V/W/H 面投影</view>
      <view class="formula-chip">虚线：不可见轮廓线</view>
    </view>
  </view>

  <view class="lesson-card" wx:else>
    <text class="lesson-index">观察 · 04</text>
    <text class="lesson-title">截平面的方向和位置决定截交线形状</text>
    <text class="lesson-body">立体保持不动，可快速选择水平面、侧平面或连续调整正垂面角度。截平面在正视图中积聚为红色直线，空间截交线及其三个投影同步更新。</text>
    <view class="formula-row">
      <view class="formula-chip">红色粗线：截交线</view>
      <view class="formula-chip">红色细线：截平面积聚投影</view>
    </view>
  </view>
  </scroll-view>

  <view class="ruler-fab" bindtap="goRuler" aria-label="尺规作图">
    <text class="ruler-fab-icon">✏</text>
    <text class="ruler-fab-label">尺规</text>
  </view>
  <view class="ai-fab" bindtap="goToAi" aria-label="AI 教师">
    <image class="ai-fab-avatar" src="/images/ai-avatar.png" mode="aspectFill" />
    <text class="ai-fab-label">问老师</text>
  </view>
</view>
