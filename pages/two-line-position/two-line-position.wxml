<view class="lesson-shell">
  <scroll-view class="lesson-scroll" scroll-y="{{true}}">
    <view class="lesson-card">
      <view class="judgement-tabs" role="tablist" aria-label="选择判断类型">
        <button
          wx:for="{{judgementOptions}}"
          wx:key="key"
          class="judgement-tab {{selectedJudgement === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="selectJudgement"
          aria-selected="{{selectedJudgement === item.key}}"
        >{{item.title}}</button>
      </view>

      <view class="position-tabs" role="tablist" aria-label="选择直线位置状态">
        <button
          wx:for="{{positionOptions}}"
          wx:key="key"
          class="position-tab {{positionMode === item.key ? 'active' : ''}}"
          data-position="{{item.key}}"
          bindtap="selectPosition"
          aria-selected="{{positionMode === item.key}}"
        >{{item.title}}</button>
      </view>

      <canvas
        id="geometryCanvas"
        type="2d"
        class="geometry-canvas"
        aria-label="两直线空间关系与第一角三视图判断图"
      ></canvas>
      <view class="legend-row">
        <text class="legend-item"><text class="legend-line line-one"></text>AB</text>
        <text class="legend-item"><text class="legend-line line-two"></text>CD</text>
        <text wx:if="{{relationKind === 'intersect'}}" class="legend-item">
          <text class="legend-dot"></text>空间交点 P
        </text>
        <text wx:if="{{relationKind === 'skew'}}" class="legend-item">
          <text class="legend-ring"></text>投影视交点（非空间交点）
        </text>
      </view>
    </view>

    <view class="criteria-card judgement-{{selectedJudgement}}" aria-live="polite">
      <view class="criteria-heading">
        <text class="criteria-title">判别准则</text>
        <text class="criteria-scope">{{positionLabel}} · {{judgementTitle}}</text>
      </view>

      <text class="criteria-base">{{criteriaRule}}</text>

      <view class="criteria-highlight">
        <text class="criteria-highlight-label">判断要点</text>
        <text class="criteria-highlight-copy">{{criteriaHighlight}}</text>
      </view>

      <text wx:if="{{criteriaNote}}" class="criteria-note">{{criteriaNote}}</text>
    </view>
  </scroll-view>
</view>
