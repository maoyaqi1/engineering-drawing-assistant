<view class="ruler-shell">
  <view class="canvas-wrap">
    <canvas
      id="rulerCanvas"
      type="2d"
      class="ruler-canvas"
      bindtouchstart="handleTouchStart"
      bindtouchmove="handleTouchMove"
      bindtouchend="handleTouchEnd"
      aria-label="尺规作图画布"
    ></canvas>
    <view class="status-bar">{{status}}</view>

    <view class="player-bar" wx:if="{{playing}}">
      <view class="player-btn" bindtap="playPrev">◀ 上一步</view>
      <view class="player-step">
        <view class="player-count">{{playIndexText}}</view>
        <view class="player-desc">{{playStepDesc}}</view>
      </view>
      <view class="player-btn" bindtap="playNext">下一步 ▶</view>
    </view>
  </view>

  <view class="hint" wx:if="{{!playing}}">严格尺规：直尺画实线/中心线，圆规=点圆心→点半径→按住圆周拖动画弧（拖满一圈为整圆）。拖动空白平移、双指缩放。</view>

  <view class="toolbar">
    <view class="tool {{tool === 'pan' ? 'active' : ''}}" data-t="pan" bindtap="onTool">移动</view>
    <view class="tool {{tool === 'point' ? 'active' : ''}}" data-t="point" bindtap="onTool">点</view>
    <view class="tool {{tool === 'line' ? 'active' : ''}}" data-t="line" bindtap="onTool">直尺</view>
    <view class="tool {{tool === 'centerline' ? 'active' : ''}}" data-t="centerline" bindtap="onTool">中心线</view>
    <view class="tool {{tool === 'circle' ? 'active' : ''}}" data-t="circle" bindtap="onTool">圆规</view>
    <view class="tool {{tool === 'select' ? 'active' : ''}}" data-t="select" bindtap="onTool">删除</view>
    <view class="tool" bindtap="undoBtn">撤销</view>
    <view class="tool" bindtap="redoBtn">重做</view>
    <view class="tool danger" bindtap="clearBtn">清空</view>
    <view class="tool replay {{playing ? 'active' : ''}}" bindtap="togglePlayback">{{playing ? '退出回放' : '回放'}}</view>
  </view>
</view>
