.ruler-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #eef3f8;
}

.canvas-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  margin: 12rpx 16rpx 8rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(36, 55, 82, 0.08);
}

.ruler-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.status-bar {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  right: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(22, 132, 255, 0.9);
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
}

.player-bar {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 4rpx 14rpx rgba(36, 55, 82, 0.15);
}

.player-btn {
  flex: 0 0 auto;
  min-width: 96rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #1684ff;
  color: #ffffff;
  font-size: 24rpx;
}

.player-step {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.player-count {
  color: #0877dd;
  font-size: 24rpx;
  font-weight: 700;
}

.player-desc {
  color: #4a5a6e;
  font-size: 22rpx;
  line-height: 1.3;
  margin-top: 2rpx;
}

.hint {
  margin: 0 16rpx 8rpx;
  color: #768397;
  font-size: 21rpx;
  line-height: 1.5;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dde3eb;
  background: #ffffff;
}

.tool {
  flex: 0 0 calc((100% - 36rpx) / 4);
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  border: 1rpx solid #c3ccd8;
  background: #f5f8fb;
  color: #3b4a60;
  font-size: 26rpx;
  box-sizing: border-box;
}

.tool.active {
  border-color: #1684ff;
  background: #eaf3ff;
  color: #0877dd;
  font-weight: 700;
}

.tool.danger {
  color: #c0392b;
}

.tool.replay {
  color: #0b7a45;
  border-color: #7ed0a5;
  background: #eefaf3;
}

.tool.replay.active {
  border-color: #0b7a45;
  background: #d8f4e5;
  color: #0b7a45;
  font-weight: 700;
}

/* ---- 宽屏适配（PAD / 折叠屏 / 横屏）：文字与控件保持与手机等大 ----
   rpx 会随窗口宽度放大，这里按 1rpx = 0.5px 换算成 px，使大屏上的字号、间距、按钮与手机一致。 */
@media (min-width: 500px) {
  .canvas-wrap { margin: 6px 8px 4px; border-radius: 8px; box-shadow: 0 3px 10px rgba(36, 55, 82, 0.08); }
  .status-bar { top: 6px; left: 7px; right: 7px; padding: 4px 8px; border-radius: 5px; font-size: 11px; }
  .player-bar { left: 7px; right: 7px; bottom: 7px; gap: 6px; padding: 5px 6px; border-radius: 6px; box-shadow: 0 2px 7px rgba(36, 55, 82, 0.15); }
  .player-btn { min-width: 48px; height: 28px; padding: 0 6px; border-radius: 5px; font-size: 12px; }
  .player-count { font-size: 12px; }
  .player-desc { font-size: 11px; margin-top: 1px; }
  .hint { margin: 0 8px 4px; font-size: 10.5px; }
  .toolbar { gap: 6px; padding: 6px 8px calc(7px + env(safe-area-inset-bottom)); border-top: 0.5px solid #dde3eb; }
  .tool { flex: 0 0 calc((100% - 18px) / 4); height: 33px; border-radius: 6px; border: 0.5px solid #c3ccd8; font-size: 13px; }
}
