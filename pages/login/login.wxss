.login-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 48rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #eef1f6;
  overflow: hidden;
}

.login-watermark {
  position: absolute;
  top: 44%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  pointer-events: none;
}

.login-hero {
  position: relative;
  z-index: 2;
  margin-top: 180rpx;
  text-align: center;
}

.login-title {
  display: block;
  color: #14181f;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.login-sub {
  display: block;
  margin-top: 20rpx;
  color: #5a6472;
  font-size: 31rpx;
  letter-spacing: 3rpx;
}

.login-bottom {
  position: relative;
  z-index: 2;
  margin-top: auto;
  text-align: center;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100rpx;
  margin: 0;
  padding: 0;
  line-height: 100rpx;
  border-radius: 50rpx;
  background: #2b6cff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 26rpx rgba(43, 108, 255, 0.34);
}

.wx-icon {
  width: 44rpx;
  height: 44rpx;
}

.login-hint {
  display: block;
  margin-top: 28rpx;
  color: #98a1ad;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 36rpx;
  color: #9aa3ae;
  font-size: 23rpx;
}

.agree-box {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #b6c0ce;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
}

.agree-box.checked {
  background: #2b6cff;
  border-color: #2b6cff;
}

.agree-text {
  flex: 1;
  min-width: 0;
  text-align: left;
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}

.agree-row .link {
  color: #2b6cff;
}

.login-error {
  display: block;
  margin-top: 20rpx;
  color: #e04444;
  font-size: 24rpx;
}
