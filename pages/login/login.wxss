.login-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 48rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #eef1f6;
  overflow: hidden;
}

.login-watermark {
  position: absolute;
  top: 44%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  pointer-events: none;
}

.login-hero {
  position: relative;
  z-index: 2;
  margin-top: 180rpx;
  text-align: center;
}

.login-title {
  display: block;
  color: #14181f;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.login-sub {
  display: block;
  margin-top: 20rpx;
  color: #5a6472;
  font-size: 31rpx;
  letter-spacing: 3rpx;
}

.login-bottom {
  position: relative;
  z-index: 2;
  margin-top: auto;
  text-align: center;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100rpx;
  margin: 0;
  padding: 0;
  line-height: 100rpx;
  border-radius: 50rpx;
  background: #2b6cff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 26rpx rgba(43, 108, 255, 0.34);
}

.wx-icon {
  width: 44rpx;
  height: 44rpx;
}

.login-hint {
  display: block;
  margin-top: 28rpx;
  color: #98a1ad;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 36rpx;
  color: #9aa3ae;
  font-size: 23rpx;
}

.agree-box {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #b6c0ce;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
}

.agree-box.checked {
  background: #2b6cff;
  border-color: #2b6cff;
}

.agree-text {
  flex: 1;
  min-width: 0;
  text-align: left;
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}

.agree-row .link {
  color: #2b6cff;
}

.login-error {
  display: block;
  margin-top: 20rpx;
  color: #e04444;
  font-size: 24rpx;
}

/* ---- 宽屏适配（PAD / 折叠屏 / 横屏）：文字与控件保持与手机等大 ----
   rpx 会随窗口宽度放大，这里按 1rpx = 0.5px 换算成 px，使大屏上的字号、间距、按钮与手机一致。 */
@media (min-width: 500px) {
  .login-shell { padding: 20px 24px calc(30px + env(safe-area-inset-bottom)); }
  .login-watermark { width: 280px; }
  .login-hero { margin-top: 90px; }
  .login-title { font-size: 27px; letter-spacing: 0.5px; }
  .login-sub { margin-top: 10px; font-size: 15.5px; letter-spacing: 1.5px; }
  .login-button { gap: 6px; height: 50px; line-height: 50px; border-radius: 25px; font-size: 16px; letter-spacing: 0.5px; box-shadow: 0 6px 13px rgba(43, 108, 255, 0.34); }
  .wx-icon { width: 22px; height: 22px; }
  .login-hint { margin-top: 14px; font-size: 12.5px; letter-spacing: 0.5px; }
  .agree-row { gap: 6px; margin-top: 18px; font-size: 11.5px; }
  .agree-box { width: 17px; height: 17px; border: 1px solid #b6c0ce; font-size: 10px; }
  .agree-text { letter-spacing: 0.15px; }
  .login-error { margin-top: 10px; font-size: 12px; }
}
